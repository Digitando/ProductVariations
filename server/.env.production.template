# ===================================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# ===================================================================
# IMPORTANT: This is a template. Copy and configure for your production environment.
# NEVER commit actual .env.production with real secrets to version control!
# ===================================================================

# ===================================================================
# CRITICAL - MUST BE SET FOR PRODUCTION
# ===================================================================

# Node Environment - MUST be 'production'
NODE_ENV=production

# JWT Secret - Generate new one for production (32+ characters)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRITICAL: Use a DIFFERENT secret than development!
JWT_SECRET=

# CORS Allowed Origins - Your production frontend URL(s)
# Examples:
# Single: https://yourdomain.com
# Multiple: https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com
CLIENT_ORIGIN=

# ===================================================================
# SERVER CONFIGURATION
# ===================================================================

# Port (Railway/Render/Fly.io will set PORT automatically)
PORT=${PORT:-5050}

# Public Asset Base URL (use CDN if you have one)
# Example: https://cdn.yourdomain.com
PUBLIC_ASSET_BASE_URL=

# ===================================================================
# DATABASE - REQUIRED FOR PRODUCTION
# ===================================================================

# Supabase Configuration (STRONGLY RECOMMENDED for production)
# Sign up at: https://supabase.com
# Get from: Project Settings > API > URL and Service Key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===================================================================
# API SERVICES
# ===================================================================

# OpenRouter API Key (REQUIRED for image generation)
# Get yours at: https://openrouter.ai
OPENROUTER_API_KEY=

# OpenRouter Site Info (optional but recommended)
OPENROUTER_SITE_URL=https://yourdomain.com
OPENROUTER_SITE_NAME=Your App Name

# ===================================================================
# PAYMENT PROCESSING
# ===================================================================

# Stripe Secret Key - PRODUCTION KEY (starts with sk_live_)
# Get yours at: https://dashboard.stripe.com/apikeys
# CRITICAL: Use LIVE key, not test key!
STRIPE_SECRET_KEY=

# ===================================================================
# OAUTH PROVIDERS
# ===================================================================

# Google OAuth - Production Credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===================================================================
# DEBUGGING & MONITORING (OPTIONAL)
# ===================================================================

# Enable detailed errors in production (ONLY for debugging)
# WARNING: Set to 'false' in production for security!
# Temporarily set to 'true' to debug issues, then disable
DEBUG=false
SHOW_ERRORS=false

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# ===================================================================
# EMAIL SERVICE (OPTIONAL)
# ===================================================================

# SMTP Configuration for sending emails
# Example providers: SendGrid, Mailgun, AWS SES
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Your App Name

# ===================================================================
# RAILWAY-SPECIFIC VARIABLES
# ===================================================================
# These are automatically set by Railway, but you can override if needed

# Railway automatically sets:
# - PORT (the port your app should listen on)
# - RAILWAY_ENVIRONMENT (development, staging, production)
# - RAILWAY_SERVICE_NAME
# - RAILWAY_PROJECT_ID

# ===================================================================
# SECURITY CHECKLIST
# ===================================================================
# Before deploying to production, ensure:
# ✓ NODE_ENV=production
# ✓ Strong JWT_SECRET (different from dev, 32+ chars)
# ✓ CLIENT_ORIGIN set to your actual domain(s)
# ✓ HTTPS enabled on your domain
# ✓ Supabase configured (recommended)
# ✓ All API keys are PRODUCTION keys, not test keys
# ✓ DEBUG=false and SHOW_ERRORS=false
# ✓ Stripe uses sk_live_ key (not sk_test_)
# ✓ Google OAuth configured for production domains
# ✓ This file is NOT committed to git (add to .gitignore)
# ===================================================================
