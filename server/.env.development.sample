# ===================================================================
# SAMPLE DEVELOPMENT ENVIRONMENT FILE
# ===================================================================
# Copy this file to .env and update with your actual values
# Command: cp .env.development.sample .env
# ===================================================================

# ===================================================================
# SECURITY CRITICAL - REQUIRED
# ===================================================================

# JWT Secret - REQUIRED (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Example output: NRiyq/HekMGdSRs0HpP5bJwh9V1NjtZl7zdFCV3UFbw=
JWT_SECRET=NRiyq/HekMGdSRs0HpP5bJwh9V1NjtZl7zdFCV3UFbw=

# CORS Allowed Origins - REQUIRED
# For development with Vite default port:
CLIENT_ORIGIN=http://localhost:5173
# For multiple origins (production): CLIENT_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ===================================================================
# SERVER CONFIGURATION
# ===================================================================

# Server Port
PORT=5050

# Node Environment (development | production)
NODE_ENV=development

# Public Asset Base URL (optional - for CDN)
PUBLIC_ASSET_BASE_URL=

# ===================================================================
# API CONFIGURATION
# ===================================================================

# OpenRouter API Key (required for image generation)
# Get yours at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenRouter Optional Settings
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# ===================================================================
# DATABASE (OPTIONAL - falls back to local JSON storage)
# ===================================================================

# Supabase Configuration
# Sign up at: https://supabase.com
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===================================================================
# PAYMENT PROCESSING (OPTIONAL)
# ===================================================================

# Stripe Secret Key
# Get yours at: https://dashboard.stripe.com/apikeys
# Use test key (sk_test_...) for development
STRIPE_SECRET_KEY=

# ===================================================================
# OAUTH (OPTIONAL)
# ===================================================================

# Google OAuth Configuration
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===================================================================
# NOTES
# ===================================================================
# 1. NEVER commit .env files to version control
# 2. Use different secrets for dev/staging/production
# 3. Keep JWT_SECRET at least 32 characters long
# 4. In production, set NODE_ENV=production
# 5. In production, use HTTPS and update CLIENT_ORIGIN accordingly
