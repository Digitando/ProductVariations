# API Configuration
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Server Configuration
PORT=5050
NODE_ENV=development
PUBLIC_ASSET_BASE_URL=

# SECURITY CRITICAL: CORS Configuration
# REQUIRED: Set allowed origins (comma-separated for multiple)
# Example: http://localhost:5173,https://yourdomain.com
# WARNING: Never use '*' in production!
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (Optional - falls back to local JSON storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# SECURITY CRITICAL: JWT Secret
# REQUIRED: Must be at least 32 characters long
# Generate a secure random string: openssl rand -base64 32
# WARNING: Never use 'change-me' or commit this to git!
JWT_SECRET=

# Payment Configuration (Optional)
STRIPE_SECRET_KEY=

# OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
